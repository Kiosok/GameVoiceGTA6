# Source allowlist: recordings, API credentials, builds and local reports stay local.
*
!.gitignore
!.gitattributes
!README.md
!requirements-dev.txt
!docs/
!docs/*.md
!tools/
!tools/*.py
!outputs/
outputs/*
!outputs/GameVoice/
outputs/GameVoice/*
!outputs/GameVoice/*.py
!outputs/GameVoice/requirements*.txt
!work/
work/*
!work/test_*.py
work/test_station_wasapi.py
work/test_bret_temporary.py
!work/*.spec
!work/pipeline_daemon.py
!work/pipeline_jobs.py
!work/start_continuous_collection.py
!work/start_voice_pipeline.py
!work/voice_gpu_backend.py
!work/recording_gamevoice.py
# Defence in depth for future source directories.
**/__pycache__/
**/*.pyc
**/*.dpapi
**/.env*
**/*.wav
**/*.mp3
**/*.mp4
**/*.mkv
**/*.sqlite*
**/*.exe
**/*.log
**/venv/
**/.venv*/
**/voice-samples/
**/voice-packs/
**/private-*/
